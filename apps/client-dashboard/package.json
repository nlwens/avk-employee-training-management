{
  "name": "client-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "prettier": "@repo/eslint-config/prettier",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:component": "vitest run --config vitest.config.ts",
    "test:component:watch": "vitest --watch --config vitest.config.ts",
    "test:component:coverage": "vitest run --coverage --config vitest.config.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/react": "^0.4.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@tanstack/react-table": "^8.21.3",
    "dotenv": "^17.4.1",
    "i18n": "*",
    "i18next": "^26.0.10",
    "lucide-react": "^0.469.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.7",
    "react-router-dom": "^7.15.0",
    "tailwindcss": "^4.2.4",
    "ui": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@repo/eslint-config": "*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
