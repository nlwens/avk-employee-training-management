{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "i18n/locales/**/*.json",
        "outDir": "./dist",
        "watchAssets": true
      },
      {
        "include": "mailer/templates/**/*.mjml",
        "outDir": "./dist",
        "watchAssets": true
      },
      {
        "include": "mailer/assets/**/*",
        "outDir": "./dist",
        "watchAssets": true
      }
    ]
  }
}
