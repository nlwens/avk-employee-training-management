<mjml>
  <mj-head>
    <mj-include path="./partials/head.mjml" />
    <mj-preview>{{t "mail.welcome.title"}}</mj-preview>
  </mj-head>

  <mj-body background-color="#FFFFFF">
    <mj-include path="./partials/header.mjml" />

    <mj-section background-color="#FFFFFF" padding="40px 40px 8px">
      <mj-column>
        <mj-text color="#002395" font-size="22px" font-weight="bold" line-height="1.3" padding="0 0 20px">
          {{t "mail.welcome.title"}}
        </mj-text>

        <mj-text padding="0 0 12px">{{t "mail.welcome.greeting" name=name}}</mj-text>
        <mj-text padding="0 0 20px">{{t "mail.welcome.body"}}</mj-text>

        <mj-button href="{{activationLink}}">{{t "mail.welcome.button"}}</mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFFFFF" padding="0 40px 40px">
      <mj-column>
        <mj-text color="#666666" font-size="13px" padding="0">
          {{t "mail.welcome.noteExpiry" hours=expiryHours}}
        </mj-text>
      </mj-column>
    </mj-section>

    {{> footer}}
  </mj-body>
</mjml>
