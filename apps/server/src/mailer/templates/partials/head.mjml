<mj-attributes>
  <mj-all font-family="Arial, Helvetica, sans-serif" />

  <mj-text color="#333333" font-size="15px" line-height="1.7" padding="0 0 16px" />

  <mj-button
    background-color="#002395"
    color="#FFFFFF"
    font-size="14px"
    font-weight="bold"
    border-radius="0"
    inner-padding="14px 28px"
    align="left"
    padding="8px 0 0"
  />

  <mj-divider border-color="#E0E0E0" border-width="1px" padding="16px 0" />
</mj-attributes>

<mj-style>
  @media only screen and (max-width: 480px) {
    .header-col td, .header-col div {
      text-align: center !important;
    }

    .header-col table {
      margin: 0 auto !important;
    }
  }
</mj-style>
