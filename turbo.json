{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": ["JWT_SECRET", "PLAYWRIGHT_BROWSERS_PATH"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:e2e:ui": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test:e2e:ci": {
      "cache": false,
      "env": [
        "JWT_SECRET",
        "PLAYWRIGHT_BROWSERS_PATH",
        "ADMIN_EMAIL",
        "ADMIN_PASSWORD"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:component": {
      "outputs": ["coverage/**", "test-results/**"]
    },
    "test:component:coverage": {
      "outputs": ["coverage/**", "test-results/**"]
    },
    "test:component:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
